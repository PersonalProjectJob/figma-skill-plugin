# ---------------------------------------------------------------------------
# Tài khoản cho automation — dán vào `.env.local` của REPO GỐC (đã gitignore).
#
# Chỉ cần khai ở repo gốc: worktree không có file này (git worktree không mang
# theo file bị ignore), nhưng kit tự đọc `.env.local` của repo gốc theo path
# tuyệt đối, và `/dispatch` Bước 3.5 cũng copy sang worktree.
#
# TUYỆT ĐỐI: chỉ dùng tài khoản test trên môi trường dev/staging. Không bao giờ
# đặt tài khoản merchant thật hay tài khoản cá nhân vào đây.
# ---------------------------------------------------------------------------

# Môi trường đang nhắm. Đặt cái này thì kit ưu tiên nhóm biến E2E_<ENV>_*
# tương ứng, và lấy luôn base URL bên dưới làm target khi không truyền --target.
# Giá trị nhận: DEV | STAGING | TEST | PROD | LOCAL (không phân biệt hoa/thường)
E2E_TARGET=staging

# Base URL theo từng môi trường.
# Có project mà dev/staging CÙNG chạy localhost (phân biệt môi trường bằng build
# mode chứ không bằng host) — nếu đúng vậy thì URL localhost lặp lại ở cả hai
# dòng dưới là ĐÚNG, không phải placeholder bỏ quên. Kit hiểu URL localhost là
# dev server: vẫn dò port, vẫn nhắc đúng lệnh khởi động.
E2E_DEV_BASE_URL=http://localhost:3000
E2E_STAGING_BASE_URL=http://localhost:3000

# API base KỲ VỌNG theo từng môi trường. Kit đối chiếu host API mà trang thật sự
# gọi với biến này — lệch thì báo ENV_MISMATCH thay vì nộp bằng chứng sai môi trường.
# Đổi 2 domain ví dụ dưới đây thành API thật của project bạn.
E2E_DEV_API_BASE=https://api.dev.example.com
E2E_STAGING_API_BASE=https://api.staging.example.com

# Dự phòng khi chưa khai biến theo môi trường (script chụp evidence riêng của
# repo bạn, nếu có, cũng thường đọc đúng biến này)
E2E_API_BASE=https://api.dev.example.com

# ---------------------------------------------------------------------------
# Tài khoản. Role là TỰ DO — thêm role mới chỉ là thêm 2 dòng, không phải sửa
# file nào trong kit. Gọi bằng `--role <ten-role-viet-thuong>`.
#
# Hai dạng tên, dạng có môi trường thắng khi E2E_TARGET được đặt:
#     E2E_<ROLE>_EMAIL          / E2E_<ROLE>_PASSWORD          (phẳng, mọi môi trường)
#     E2E_<ENV>_<ROLE>_EMAIL    / E2E_<ENV>_<ROLE>_PASSWORD    (riêng từng môi trường)
#
# Khai đủ CẢ CẶP email + password. Thiếu một nửa thì probe báo "THIẾU NỬA" và
# role đó không dùng được — đây là lỗi hay gặp nhất.
# ---------------------------------------------------------------------------

E2E_DEV_OWNER_EMAIL=owner-test@example.com
E2E_DEV_OWNER_PASSWORD=

E2E_DEV_STAFF_EMAIL=staff-test@example.com
E2E_DEV_STAFF_PASSWORD=

# Ví dụ thêm role mới — dùng ngay được bằng `--role manager`, không sửa code
# E2E_DEV_MANAGER_EMAIL=manager-test@example.com
# E2E_DEV_MANAGER_PASSWORD=

# Ví dụ role dùng chung mọi môi trường (dạng phẳng)
# E2E_CUSTOMER_EMAIL=customer-test@example.com
# E2E_CUSTOMER_PASSWORD=

# ---------------------------------------------------------------------------
# Đổi môi trường cho MỘT lượt (không sửa file): thêm --env dev vào lệnh.
#
# Kiểm lại sau khi sửa file (in ra TÊN biến, không in giá trị):
#   node <skill>/bin/e2e-probe.mjs <repo>
# Đọc dòng "role dùng được" và bảng "tài khoản khai trong .env.local".
# ---------------------------------------------------------------------------
